+
+#ifdef __aarch64__
+/*
+ * Patch a function-pointer slot and hand back an entry that still reaches the code which
+ * was there before.  On a target whose text and rodata are taken away at EL2 the slot is
+ * never written: the function it points at gets a branch instead, so the only callable
+ * entry is the stub that branch patch installs.  That stub has to be published before the
+ * branch goes live, otherwise a replacement that calls "the original" jumps back into the
+ * entry it just replaced.
+ */
+int ksu_patch_text_callthru(void *dst, void *src, size_t len, void **callthru, int flags);
+#else
+static inline int ksu_patch_text_callthru(void *dst, void *src, size_t len, void **callthru, int flags)
+{
+    int ret;
+
+    if (!callthru)
+        return ksu_patch_text(dst, src, len, flags);
+    WRITE_ONCE(*callthru, READ_ONCE(*(void **)dst));
+    smp_wmb();
+    ret = ksu_patch_text(dst, src, len, flags);
+    if (ret)
+        WRITE_ONCE(*callthru, NULL);
+    return ret;
+}
+#endif
