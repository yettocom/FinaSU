+/// Clear whatever is already at the daemon path, so the copy/rename below can take its place.
+/// The file may be marked immutable; clear the flag and retry once in that case.
+fn remove_daemon() {
+    if let Err(e) = std::fs::remove_file(defs::DAEMON_PATH)
+        && e.kind() == PermissionDenied
+        && clear_immutable(Path::new(defs::DAEMON_PATH)).is_ok()
+    {
+        let _ = std::fs::remove_file(defs::DAEMON_PATH);
     }
+}
+
+/// Put this executable in place as the daemon.
+pub fn stage_daemon() -> Result<()> {
+    ensure_dir_exists(defs::ADB_DIR)?;
+    remove_daemon();
     std::fs::copy(
         // We should use /proc/self/exe, DO NOT resolve the real path
         // So that if someone execute /data/adb/ksud install, ksud won't be removed unexpectedly
         "/proc/self/exe",
         defs::DAEMON_PATH,
     )?;
+
+    Ok(())
+}
+
+/// Move a daemon that late-load staged elsewhere into place.
+///
+/// late-load has to install ksud BEFORE it loads kernelsu.ko: loading the module switches this
+/// process into the KernelSU SELinux domain, and the copy into /data/adb/ksud is refused from
+/// there (the destination is left as a zero-byte file).  The kit therefore stages the binary
+/// while it still has the bootstrap context, and this renames it onto the same filesystem.
+///
+/// A caller that stages nothing (DFRoot's bootstrap, Magica) is already running the daemon it
+/// wants installed, so that case falls back to copying /proc/self/exe - still before the module
+/// load, so still from the bootstrap context.
+pub fn stage_daemon_from(staged_exe: impl AsRef<Path>) -> Result<()> {
+    let staged = staged_exe.as_ref();
+    ensure_dir_exists(defs::ADB_DIR)?;
+
+    if std::fs::symlink_metadata(staged).is_err() {
+        return stage_daemon();
+    }
+
+    // The staged binary sits in a shell-writable directory, so only take a root-owned regular
+    // file that nobody else can rewrite: rename(2) moves a symlink as a symlink, and the
+    // chown/chmod below follow it.
+    let meta = std::fs::symlink_metadata(staged)
+        .with_context(|| format!("Failed to stat staged daemon {}", staged.display()))?;
+    if !meta.is_file() || meta.uid() != 0 || (meta.mode() & 0o022) != 0 {
+        bail!(
+            "Refusing to install {} as the daemon: not a root-owned regular file",
+            staged.display()
+        );
+    }
+
+    // rename(2) replaces the destination atomically, so a failed stage leaves the previous
+    // daemon in place.  Only the immutable flag refuses the replacement, with EPERM; clear it
+    // and retry once.
+    if let Err(e) = std::fs::rename(staged, defs::DAEMON_PATH) {
+        if e.kind() != PermissionDenied || clear_immutable(Path::new(defs::DAEMON_PATH)).is_err() {
+            return Err(e).with_context(|| {
+                format!(
+                    "Failed to rename {} to {}",
+                    staged.display(),
+                    defs::DAEMON_PATH
+                )
+            });
+        }
+        std::fs::rename(staged, defs::DAEMON_PATH).with_context(|| {
+            format!(
+                "Failed to rename {} to {}",
+                staged.display(),
+                defs::DAEMON_PATH
+            )
+        })?;
+    }
+
+    // Re-check what actually landed: the chown/chmod below follow symlinks.
+    let meta = std::fs::symlink_metadata(defs::DAEMON_PATH)
+        .with_context(|| format!("Failed to stat {}", defs::DAEMON_PATH))?;
+    if !meta.is_file() {
+        let _ = std::fs::remove_file(defs::DAEMON_PATH);
+        bail!("Refusing to keep a non-regular file at {}", defs::DAEMON_PATH);
+    }
+
+    chown(defs::DAEMON_PATH, Some(Uid::ROOT), Some(Gid::ROOT))?;
+    #[cfg(unix)]
+    set_permissions(defs::DAEMON_PATH, Permissions::from_mode(0o755))?;
+
+    Ok(())
+}
